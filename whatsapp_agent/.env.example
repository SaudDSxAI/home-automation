# Copy this file to .env and fill in YOUR values. Never share or upload .env.
# Write each value right after the = sign. Do not put comments on the same line as a value.

# Your WhatsApp agent API key (WhatsApp > Settings > Agents > Add agent > copy the API key)
WHATSAPP_TOKEN=
# Your own WhatsApp number with country code, digits only (only this number may control the home)
WHATSAPP_ALLOWED_NUMBER=
# Any secret word. Send "PAIR <word>" from WhatsApp once to connect your chat.
WHATSAPP_PAIR_CODE=

# OpenAI key (understands any sentence + voice notes). Without it a simple word reader is used.
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Cloud mode (works from any internet): your Adafruit IO username and key
MQTT_USER=
MQTT_KEY=
# MQTT_HOST=io.adafruit.com
# MQTT_PORT=8883

# Local WiFi mode (used only when MQTT_USER is empty): the Arduino's IP from the Serial Monitor
ARDUINO_IP=

# Repeat an unresolved alert every N minutes (default 10)
ALERT_COOLDOWN_MIN=10
